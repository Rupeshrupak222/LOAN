// Adyapan Loan Management System - Prisma schema
// Money values use Decimal (PostgreSQL NUMERIC). Never floating point.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Multi-Tenant / Company Architecture
// ---------------------------------------------------------------------------

enum TenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum TenantTier {
  ENTERPRISE
  GROWTH
  STANDARD
}

model Tenant {
  id                String            @id @default(uuid())
  code              String            @unique
  name              String
  status            TenantStatus      @default(ACTIVE)
  tier              TenantTier        @default(STANDARD)
  cinNumber         String?
  rbiRegistrationNo String?
  domain            String?
  contactEmail      String
  supportPhone      String?
  baseCurrency      String            @default("INR")
  country           String            @default("IN")
  timezone          String            @default("Asia/Kolkata")
  settings          Json?
  metadata          Json?
  createdBy         String?
  suspendedAt       DateTime?
  activatedAt       DateTime?         @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  branches          Branch[]
  users             User[]
  customers         Customer[]
  loanProducts      LoanProduct[]
  applications      LoanApplication[]
  loans             Loan[]
  payments          Payment[]
  auditLogs         AuditLog[]
  workQueues        WorkQueue[]
  tasks             Task[]
  activityLogs      ActivityLog[]
  approvals         Approval[]

  @@index([code])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Auth / RBAC
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  employeeId          String?        @unique
  passwordHash        String
  firstName           String
  lastName            String
  status              UserStatus     @default(ACTIVE)
  tenantId            String?
  tenant              Tenant?        @relation(fields: [tenantId], references: [id])
  branchId            String?
  branch              Branch?        @relation(fields: [branchId], references: [id])

  // login security
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  mfaEnabled          Boolean        @default(false)

  roles               UserRole[]
  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]
  customer            Customer?

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([email])
  @@index([tenantId])
  @@index([branchId])
  @@index([tenantId, branchId])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // SUPER_ADMIN, COMPANY_ADMIN, ADMIN, LOAN_OFFICER, etc.
  description String?
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique // e.g. customers.read, loans.approve
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Branches
// ---------------------------------------------------------------------------

model Branch {
  id           String            @id @default(uuid())
  code         String
  name         String
  city         String?
  state        String?
  isActive     Boolean           @default(true)
  tenantId     String?
  tenant       Tenant?           @relation(fields: [tenantId], references: [id])
  users        User[]
  customers    Customer[]
  applications LoanApplication[]
  loans        Loan[]
  createdAt    DateTime          @default(now())

  @@unique([tenantId, code])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

enum CustomerStatus {
  DRAFT
  ACTIVE
  KYC_PENDING
  KYC_VERIFIED
  BLOCKED
  INACTIVE
}

enum KycStatus {
  NOT_STARTED
  PENDING
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum RiskCategory {
  LOW
  MEDIUM
  HIGH
}

model Customer {
  id                  String                @id @default(uuid())
  customerCode        String                @unique
  userId              String?               @unique
  user                User?                 @relation(fields: [userId], references: [id])
  tenantId            String?
  tenant              Tenant?               @relation(fields: [tenantId], references: [id])
  branchId            String?
  branch              Branch?               @relation(fields: [branchId], references: [id])

  firstName           String
  lastName            String
  dateOfBirth         DateTime?
  gender              String?
  mobile              String
  email               String?
  addressLine         String?
  city                String?
  state               String?
  pincode             String?

  employmentType      String?
  employerName        String?
  monthlyIncome       Decimal?              @db.Decimal(14, 2)
  existingObligations Decimal?              @db.Decimal(14, 2)

  bankName            String?
  bankAccountNo       String?
  bankIfsc            String?

  kycStatus           KycStatus             @default(NOT_STARTED)
  riskCategory        RiskCategory?
  status              CustomerStatus        @default(DRAFT)

  addresses           CustomerAddress[]
  identifiers         CustomerIdentifier[]
  employmentDetails   CustomerEmployment[]
  bankAccounts        CustomerBankAccount[]
  applications        LoanApplication[]
  loans               Loan[]
  documents           Document[]
  payments            Payment[]
  paymentSubmissions  PaymentSubmission[]
  collectionCases     CollectionCase[]
  notifications       Notification[]

  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([mobile])
  @@index([email])
  @@index([status])
  @@index([tenantId])
  @@index([branchId])
  @@index([tenantId, branchId])
}

model CustomerAddress {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  addressType String   @default("CURRENT") // CURRENT, PERMANENT, OFFICE
  addressLine String
  city        String
  state       String
  pincode     String
  isPrimary   Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([customerId])
}

model CustomerEmployment {
  id                  String   @id @default(uuid())
  customerId          String
  customer            Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  employmentType      String   @default("SALARIED") // SALARIED, SELF_EMPLOYED, BUSINESS
  employerName        String
  designation         String?
  monthlyIncome       Decimal  @db.Decimal(14, 2)
  workExperienceYears Int?
  officeAddress       String?
  createdAt           DateTime @default(now())

  @@index([customerId])
}

model CustomerBankAccount {
  id                String   @id @default(uuid())
  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  accountHolderName String
  bankName          String
  accountNumber     String
  ifscCode          String
  accountType       String   @default("SAVINGS")
  isPrimary         Boolean  @default(true)
  isVerified        Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([customerId])
}

model CustomerIdentifier {
  id                 String    @id @default(uuid())
  customerId         String
  customer           Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  idType             String    // PAN, AADHAAR, PASSPORT, VOTER_ID, DRIVING_LICENSE, GSTIN
  maskedValue        String
  idHash             String?
  encryptedValue     String?
  verificationStatus String    @default("PENDING") // PENDING, VERIFIED, REJECTED, EXPIRED
  verifiedAt         DateTime?
  verifiedBy         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([customerId])
  @@index([idType])
}

// ---------------------------------------------------------------------------
// Loan products
// ---------------------------------------------------------------------------

enum InterestMethod {
  FLAT
  REDUCING
}

model LoanProduct {
  id               String            @id @default(uuid())
  code             String
  name             String
  productType      String
  tenantId         String?
  tenant           Tenant?           @relation(fields: [tenantId], references: [id])
  minAmount        Decimal           @db.Decimal(14, 2)
  maxAmount        Decimal           @db.Decimal(14, 2)
  minTenureMonths  Int
  maxTenureMonths  Int
  interestRate     Decimal           @db.Decimal(6, 3) // annual %
  interestMethod   InterestMethod    @default(REDUCING)
  processingFeePct Decimal           @db.Decimal(6, 3) @default(0)
  lateFeePct       Decimal           @db.Decimal(6, 3) @default(0)
  gracePeriodDays  Int               @default(0)
  eligibilityRules Json?
  isActive         Boolean           @default(true)

  applications     LoanApplication[]
  loans            Loan[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Loan applications
// ---------------------------------------------------------------------------

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  KYC_PENDING
  KYC_VERIFIED
  UNDER_REVIEW
  CREDIT_ASSESSMENT
  UNDERWRITING
  APPROVED
  REJECTED
  AGREEMENT_PENDING
  READY_FOR_DISBURSEMENT
  DISBURSED
  CANCELLED
}

model LoanApplication {
  id              String                     @id @default(uuid())
  applicationNo   String                     @unique
  customerId      String
  customer        Customer                   @relation(fields: [customerId], references: [id])
  productId       String
  product         LoanProduct                @relation(fields: [productId], references: [id])
  tenantId        String?
  tenant          Tenant?                    @relation(fields: [tenantId], references: [id])
  branchId        String?
  branch          Branch?                    @relation(fields: [branchId], references: [id])

  requestedAmount Decimal                    @db.Decimal(14, 2)
  tenureMonths    Int
  purpose         String?
  status          ApplicationStatus          @default(DRAFT)
  stage           String?                    @default("LEAD")
  priority        String?                    @default("MEDIUM")
  assignedToUserId String?
  queueId         String?
  submittedAt     DateTime?
  closedAt        DateTime?

  statusHistory   ApplicationStatusHistory[]
  eligibility     EligibilityAssessment?
  riskAssessment  RiskAssessment?
  underwriting    UnderwritingDecision?
  approvals       ApprovalRequest[]
  documents       Document[]
  loan            Loan?
  assignments     ApplicationAssignment[]
  tasks           Task[]
  creditReviews   CreditReview[]
  approvalRecords Approval[]

  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([applicationNo])
  @@index([customerId])
  @@index([status])
  @@index([stage])
  @@index([assignedToUserId])
  @@index([queueId])
  @@index([priority])
  @@index([tenantId])
  @@index([branchId])
  @@index([tenantId, branchId])
}

model ApplicationStatusHistory {
  id            String             @id @default(uuid())
  applicationId String
  application   LoanApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStage     String?
  fromStatus    ApplicationStatus?
  toStage       String?
  toStatus      ApplicationStatus
  changedBy     String?
  reason        String?
  metadata      Json?
  createdAt     DateTime           @default(now())

  @@index([applicationId])
}

model EligibilityAssessment {
  id            String          @id @default(uuid())
  applicationId String          @unique
  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  result        String          // ELIGIBLE, CONDITIONALLY_ELIGIBLE, NOT_ELIGIBLE
  factors       Json
  createdAt     DateTime        @default(now())
}

model RiskAssessment {
  id            String          @id @default(uuid())
  applicationId String          @unique
  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  score         Int
  category      RiskCategory
  factors       Json
  createdAt     DateTime        @default(now())
}

model UnderwritingDecision {
  id            String          @id @default(uuid())
  applicationId String          @unique
  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  decision      String          // APPROVE, APPROVE_WITH_CONDITIONS, SEND_BACK, REJECT
  reason        String?
  decidedBy     String
  createdAt     DateTime        @default(now())
}

model ApprovalRequest {
  id             String          @id @default(uuid())
  applicationId  String
  application    LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  approverRole   String
  approverUserId String?
  level          Int             @default(1)
  status         String          @default("PENDING") // PENDING, APPROVED, REJECTED
  decisionReason String?
  actionAt       DateTime?
  createdAt      DateTime        @default(now())

  @@index([applicationId])
}

// ---------------------------------------------------------------------------
// Operational Workflow: Queues, Assignments, Tasks, Notes, Reviews & Approvals
// ---------------------------------------------------------------------------

model WorkQueue {
  id          String   @id @default(uuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  name        String
  key         String   // OPERATIONS_QUEUE, CREDIT_REVIEW_QUEUE, RISK_QUEUE, APPROVAL_QUEUE, COLLECTIONS_QUEUE, FINANCE_QUEUE
  department  String   // OPERATIONS, CREDIT, COLLECTIONS, FINANCE, MANAGEMENT, ADMIN
  workspace   String   // WorkspaceKey
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments ApplicationAssignment[]
  tasks       Task[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([department])
}

model ApplicationAssignment {
  id               String          @id @default(uuid())
  applicationId    String
  application      LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  assignedToUserId String?
  assignedByUserId String?
  queueId          String?
  queue            WorkQueue?      @relation(fields: [queueId], references: [id])
  department       String          // OPERATIONS, CREDIT, COLLECTIONS, etc.
  workspace        String?         // WorkspaceKey
  assignmentType   String          @default("INDIVIDUAL") // INDIVIDUAL, QUEUE, TEAM
  status           String          @default("ACTIVE") // ACTIVE, COMPLETED, REASSIGNED, RELEASED
  assignedAt       DateTime        @default(now())
  unassignedAt     DateTime?
  notes            String?

  @@index([applicationId])
  @@index([assignedToUserId])
  @@index([queueId])
  @@index([status])
}

model Task {
  id                String           @id @default(uuid())
  tenantId          String?
  tenant            Tenant?          @relation(fields: [tenantId], references: [id])
  title             String
  description       String?
  taskType          String           // DOCUMENT_VERIFICATION, CREDIT_REVIEW, RISK_ASSESSMENT, UNDERWRITING_DECISION, SANCTION_APPROVAL, DISBURSEMENT_CHECK, COLLECTION_FOLLOWUP, CUSTOMER_KYC
  entityType        String           // APPLICATION, CUSTOMER, LOAN, COLLECTION_CASE, DOCUMENT, APPROVAL
  entityId          String
  applicationId     String?
  application       LoanApplication? @relation(fields: [applicationId], references: [id])
  assignedToUserId  String?
  assignedTeam      String?
  queueId           String?
  queue             WorkQueue?       @relation(fields: [queueId], references: [id])
  priority          String           @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status            String           @default("OPEN") // OPEN, IN_PROGRESS, BLOCKED, COMPLETED, CANCELLED, OVERDUE
  dueAt             DateTime?
  completedAt       DateTime?
  completedByUserId String?
  createdByUserId   String?
  metadata          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([applicationId])
  @@index([assignedToUserId])
  @@index([queueId])
  @@index([status])
  @@index([priority])
  @@index([dueAt])
}

model ActivityLog {
  id              String   @id @default(uuid())
  tenantId        String?
  tenant          Tenant?  @relation(fields: [tenantId], references: [id])
  entityType      String   // APPLICATION, CUSTOMER, LOAN, COLLECTION_CASE, DOCUMENT, APPROVAL, TASK
  entityId        String
  activityType    String   // NOTE, COMMENT, CALL, FOLLOWUP, STATUS_CHANGE, ASSIGNMENT, STAGE_TRANSITION, SYSTEM_EVENT
  title           String?
  message         String
  metadata        Json?
  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([activityType])
  @@index([createdAt])
}

model CreditReview {
  id                String          @id @default(uuid())
  applicationId     String
  application       LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewerId        String?
  decision          String          @default("PENDING") // PENDING, APPROVE, APPROVE_WITH_CONDITIONS, REJECT, REFER
  score             Int?
  riskLevel         String?         @default("MEDIUM") // LOW, MEDIUM, HIGH, VERY_HIGH
  maxSanctionAmount Decimal?        @db.Decimal(14, 2)
  recommendedTenure Int?
  recommendedRate   Decimal?        @db.Decimal(6, 3)
  remarks           String?
  conditions        Json?
  factors           Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([applicationId])
  @@index([reviewerId])
  @@index([decision])
}

model Approval {
  id                String            @id @default(uuid())
  tenantId          String?
  tenant            Tenant?           @relation(fields: [tenantId], references: [id])
  entityType        String            @default("APPLICATION") // APPLICATION, LOAN, DISBURSEMENT, RESTRUCTURE, SETTLEMENT, WAIVER
  entityId          String
  applicationId     String?
  application       LoanApplication?  @relation(fields: [applicationId], references: [id])
  approvalType      String            // SANCTION, DISBURSEMENT, RESTRUCTURE, SETTLEMENT, WAIVER, POLICY_OVERRIDE
  level             Int               @default(1)
  approverRole      String?           // UNDERWRITER, BRANCH_MANAGER, CREDIT_HEAD, CRO, CFO, COMMITTEE
  requestedByUserId String?
  assignedToUserId  String?
  status            String            @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  decisionReason    String?
  comments          String?
  requestedAt       DateTime          @default(now())
  decidedAt         DateTime?
  history           ApprovalHistory[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([applicationId])
  @@index([status])
  @@index([assignedToUserId])
}

model ApprovalHistory {
  id         String   @id @default(uuid())
  approvalId String
  approval   Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  actorId    String?
  fromStatus String
  toStatus   String
  decision   String?
  comments   String?
  createdAt  DateTime @default(now())

  @@index([approvalId])
}

// ---------------------------------------------------------------------------
// Loans / Repayment / Disbursement
// ---------------------------------------------------------------------------

enum LoanStatus {
  ACTIVE
  OVERDUE
  RESTRUCTURED
  SETTLED
  CLOSED
  WRITTEN_OFF
}

model Loan {
  id                   String                  @id @default(uuid())
  loanNo               String                  @unique
  applicationId        String?                 @unique
  application          LoanApplication?        @relation(fields: [applicationId], references: [id])
  customerId           String
  customer             Customer                @relation(fields: [customerId], references: [id])
  productId            String
  product              LoanProduct             @relation(fields: [productId], references: [id])
  tenantId             String?
  tenant               Tenant?                 @relation(fields: [tenantId], references: [id])
  branchId             String?
  branch               Branch?                 @relation(fields: [branchId], references: [id])

  principal            Decimal                 @db.Decimal(14, 2)
  interestRate         Decimal                 @db.Decimal(6, 3)
  tenureMonths         Int
  emiAmount            Decimal                 @db.Decimal(14, 2)

  disbursementDate     DateTime?
  maturityDate         DateTime?
  closedAt             DateTime?

  outstandingPrincipal Decimal                 @db.Decimal(14, 2)
  outstandingInterest  Decimal                 @db.Decimal(14, 2) @default(0)
  outstandingFees      Decimal                 @db.Decimal(14, 2) @default(0)
  nextDueDate          DateTime?

  status               LoanStatus              @default(ACTIVE)

  schedule             RepaymentScheduleItem[]
  disbursements        Disbursement[]
  payments             Payment[]
  paymentSubmissions   PaymentSubmission[]
  transactions         Transaction[]
  collectionCases      CollectionCase[]
  restructures         LoanRestructure[]
  settlements          Settlement[]
  closure              LoanClosure?

  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([loanNo])
  @@index([customerId])
  @@index([status])
  @@index([nextDueDate])
  @@index([tenantId])
  @@index([branchId])
  @@index([tenantId, branchId])
}

enum InstallmentStatus {
  UPCOMING
  DUE
  PARTIALLY_PAID
  PAID
  OVERDUE
  WAIVED
}

model RepaymentScheduleItem {
  id            String            @id @default(uuid())
  loanId        String
  loan          Loan              @relation(fields: [loanId], references: [id], onDelete: Cascade)
  emiNumber     Int
  dueDate       DateTime
  principal     Decimal           @db.Decimal(14, 2)
  interest      Decimal           @db.Decimal(14, 2)
  fees          Decimal           @db.Decimal(14, 2) @default(0)
  totalDue      Decimal           @db.Decimal(14, 2)
  paidAmount    Decimal           @db.Decimal(14, 2) @default(0)
  outstanding   Decimal           @db.Decimal(14, 2)
  penaltyAmount Decimal           @db.Decimal(14, 2) @default(0)
  waivedAmount  Decimal           @db.Decimal(14, 2) @default(0)
  paidDate      DateTime?
  status        InstallmentStatus @default(UPCOMING)

  @@unique([loanId, emiNumber])
  @@index([loanId])
  @@index([dueDate])
}

enum DisbursementStatus {
  PENDING
  COMPLETED
  FAILED
}

model Disbursement {
  id          String             @id @default(uuid())
  loanId      String
  loan        Loan               @relation(fields: [loanId], references: [id])
  amount      Decimal            @db.Decimal(14, 2)
  method      String
  reference   String?
  status      DisbursementStatus @default(PENDING)
  disbursedBy String?
  createdAt   DateTime           @default(now())

  @@index([loanId])
}

// ---------------------------------------------------------------------------
// Payments / Allocations / Ledger
// ---------------------------------------------------------------------------

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
  REFUNDED
}

model Payment {
  id             String              @id @default(uuid())
  paymentNo      String              @unique
  loanId         String
  loan           Loan                @relation(fields: [loanId], references: [id])
  customerId     String
  customer       Customer            @relation(fields: [customerId], references: [id])
  tenantId       String?
  tenant         Tenant?             @relation(fields: [tenantId], references: [id])
  amount         Decimal             @db.Decimal(14, 2)
  method         String              // BANK_TRANSFER, UPI, CASH, CHEQUE, GATEWAY
  reference      String?
  idempotencyKey String?             @unique
  status         PaymentStatus       @default(PENDING)
  paidAt         DateTime            @default(now())

  allocations    PaymentAllocation[]
  createdAt      DateTime            @default(now())

  @@index([loanId])
  @@index([customerId])
  @@index([reference])
  @@index([tenantId])
}

model PaymentAllocation {
  id        String   @id @default(uuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bucket    String   // FEES, PENALTY, INTEREST, PRINCIPAL
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  @@index([paymentId])
}

enum SubmissionStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

model PaymentSubmission {
  id               String           @id @default(uuid())
  submissionNo     String           @unique
  loanId           String
  loan             Loan             @relation(fields: [loanId], references: [id], onDelete: Cascade)
  customerId       String
  customer         Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount           Decimal          @db.Decimal(14, 2)
  method           String           // UPI, NEFT, IMPS, NET_BANKING, CASH, CHEQUE
  reference        String           // UTR / Transaction reference
  payerMobile      String?
  paidAt           DateTime         @default(now())
  notes            String?
  status           SubmissionStatus @default(PENDING_VERIFICATION)
  verifiedByUserId String?
  verifiedAt       DateTime?
  rejectionReason  String?
  paymentId        String?

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([loanId])
  @@index([customerId])
  @@index([status])
  @@index([reference])
}

model Transaction {
  id          String   @id @default(uuid())
  loanId      String?
  loan        Loan?    @relation(fields: [loanId], references: [id])
  type        String   // DISBURSEMENT, PAYMENT, FEE, PENALTY, ADJUSTMENT, SETTLEMENT
  direction   String   // DEBIT, CREDIT
  amount      Decimal  @db.Decimal(14, 2)
  reference   String?
  description String?
  createdAt   DateTime @default(now())

  @@index([loanId])
  @@index([reference])
}

// ---------------------------------------------------------------------------
// Collections & Delinquency
// ---------------------------------------------------------------------------

model CollectionCase {
  id                String               @id @default(uuid())
  caseNo            String               @unique
  loanId            String
  loan              Loan                 @relation(fields: [loanId], references: [id])
  customerId        String
  customer          Customer             @relation(fields: [customerId], references: [id])
  assignedOfficerId String?
  dpd               Int                  @default(0) // Days Past Due
  agingBucket       String               @default("0-30") // 0-30, 31-60, 61-90, 91-180, 180+
  overdueAmount     Decimal              @db.Decimal(14, 2) @default(0)
  status            String               @default("OPEN") // OPEN, IN_PROGRESS, PROMISED, ESCALATED, RESOLVED, CLOSED
  priority          String               @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL

  activities        CollectionActivity[]
  promises          PromiseToPay[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([loanId])
  @@index([customerId])
  @@index([status])
  @@index([agingBucket])
}

model CollectionActivity {
  id               String         @id @default(uuid())
  caseId           String
  collectionCase   CollectionCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  activityType     String         // CALL, VISIT, SMS, EMAIL, NOTICE, LEGAL
  outcome          String         // CONTACTED, NO_ANSWER, WRONG_NUMBER, PROMISE_TO_PAY, DISPUTE, REFUSED
  notes            String
  nextFollowUpDate DateTime?
  performedBy      String
  createdAt        DateTime       @default(now())

  @@index([caseId])
}

model PromiseToPay {
  id             String         @id @default(uuid())
  caseId         String
  collectionCase CollectionCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  promisedAmount Decimal        @db.Decimal(14, 2)
  promisedDate   DateTime
  paymentMode    String?
  status         String         @default("PENDING") // PENDING, KEPT, BROKEN, CANCELLED
  recordedBy     String
  createdAt      DateTime       @default(now())

  @@index([caseId])
}

// ---------------------------------------------------------------------------
// Restructuring, Settlements & Loan Closure
// ---------------------------------------------------------------------------

model LoanRestructure {
  id               String   @id @default(uuid())
  loanId           String
  loan             Loan     @relation(fields: [loanId], references: [id])
  oldTenureMonths  Int
  newTenureMonths  Int
  oldInterestRate  Decimal  @db.Decimal(6, 3)
  newInterestRate  Decimal  @db.Decimal(6, 3)
  oldEmi           Decimal  @db.Decimal(14, 2)
  newEmi           Decimal  @db.Decimal(14, 2)
  moratoriumMonths Int      @default(0)
  reason           String
  approvedBy       String
  createdAt        DateTime @default(now())

  @@index([loanId])
}

model Settlement {
  id                String    @id @default(uuid())
  loanId            String
  loan              Loan      @relation(fields: [loanId], references: [id])
  totalOutstanding  Decimal   @db.Decimal(14, 2)
  settlementAmount  Decimal   @db.Decimal(14, 2)
  waivedAmount      Decimal   @db.Decimal(14, 2)
  reason            String
  status            String    @default("PENDING") // PENDING, APPROVED, COMPLETED, CANCELLED
  approvedBy        String?
  paidDate          DateTime?
  createdAt         DateTime  @default(now())

  @@index([loanId])
}

model LoanClosure {
  id            String   @id @default(uuid())
  loanId        String   @unique
  loan          Loan     @relation(fields: [loanId], references: [id])
  nocNumber     String   @unique
  closureType   String   // NORMAL_MATURITY, EARLY_PREPAYMENT, SETTLEMENT, WRITE_OFF
  principalPaid Decimal  @db.Decimal(14, 2)
  interestPaid  Decimal  @db.Decimal(14, 2)
  feesPaid      Decimal  @db.Decimal(14, 2)
  closedAt      DateTime @default(now())
  closedBy      String
  remarks       String?
}

// ---------------------------------------------------------------------------
// Documents
// ---------------------------------------------------------------------------

model Document {
  id              String           @id @default(uuid())
  customerId      String?
  customer        Customer?        @relation(fields: [customerId], references: [id])
  applicationId   String?
  application     LoanApplication? @relation(fields: [applicationId], references: [id])
  category        String           // IDENTITY, ADDRESS, INCOME, BANK_STATEMENT, BUSINESS, AGREEMENT, NOC
  documentType    String?
  fileName        String
  storageKey      String           // object storage key / signed URL identifier
  contentType     String?
  sizeBytes       Int?
  status          String           @default("PENDING") // PENDING, UNDER_REVIEW, VERIFIED, REJECTED
  rejectionReason String?
  verified        Boolean          @default(false)
  verifiedBy      String?
  verifiedAt      DateTime?
  expiryDate      DateTime?
  createdAt       DateTime         @default(now())

  @@index([customerId])
  @@index([applicationId])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id         String    @id @default(uuid())
  userId     String?
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  channel    String    @default("IN_APP") // IN_APP, EMAIL, SMS, WHATSAPP
  title      String
  message    String
  type       String    @default("INFO") // INFO, ALERT, SUCCESS, WARNING
  isRead     Boolean   @default(false)
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([customerId])
}

model NotificationTemplate {
  id            String   @id @default(uuid())
  code          String   @unique
  event         String
  titleTemplate String
  bodyTemplate  String
  channels      Json     // array of channel names
  isActive      Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Audit + Settings
// ---------------------------------------------------------------------------

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  tenantId      String?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id])
  role          String?
  action        String
  entity        String
  entityId      String?
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  correlationId String?
  createdAt     DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([tenantId])
  @@index([createdAt])
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  category  String?
  updatedAt DateTime @updatedAt
}
