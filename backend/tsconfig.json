{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "baseUrl": "./src",
    "paths": {
      "@/*": ["*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "src/modules/operations",
    "src/modules/core-lending",
    "src/modules/analytics/analytics-export.service.ts",
    "src/modules/analytics/analytics-metrics.service.ts",
    "src/modules/analytics/analytics-utils.ts",
    "src/modules/analytics/reporting-snapshot.service.ts"
  ]
}
