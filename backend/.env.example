# =============================================================================
# ADYAPAN LOAN MANAGEMENT SYSTEM (LMS) - BACKEND ENVIRONMENT CONFIGURATION
# =============================================================================

# 1. RUNTIME CONFIGURATION
# Set to 'production' in production deployments, 'development' locally
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
# Allowed CORS origins (comma-separated for multiple origins, no wildcard in prod)
CORS_ORIGIN=http://localhost:3000

# 2. REQUIRED DATABASE CREDENTIALS (Prisma ORM)
# Production requires a valid PostgreSQL connection string (min 10 max 50 pool connections recommended)
DATABASE_URL=postgresql://user:password@host:5432/adyapan_lms?schema=public
DIRECT_URL=postgresql://user:password@host:5432/adyapan_lms?schema=public

# 3. REQUIRED AUTHENTICATION SECRETS
# In production, must be at least 32 cryptographically random characters (e.g. openssl rand -hex 32)
JWT_ACCESS_SECRET=your_long_random_access_jwt_secret_minimum_32_characters
JWT_REFRESH_SECRET=your_long_random_refresh_jwt_secret_minimum_32_characters
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# 4. SECURITY & RATE LIMITING
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# 5. OPTIONAL SUPABASE INTEGRATION (if utilizing Supabase Auth / Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 6. OPTIONAL REDIS (Cache & Distributed Worker Queue)
# If omitted, system safely falls back to local in-memory queue & cache
REDIS_URL=redis://localhost:6379

# 7. OPTIONAL CLOUDINARY (Encrypted KYC Vault & Document Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 8. OPTIONAL GOOGLE GEMINI AI (Advisory Intelligence & Fraud Detection)
# Remains backend-only. Never expose to frontend.
GEMINI_API_KEY=your_google_gemini_api_key
GEMINI_MODEL=gemma-4-31b-it

# 9. OPTIONAL THIRD-PARTY GATEWAYS (Intentionally OUT OF SCOPE for Step 52)
# PAYMENT_GATEWAY_KEY_ID=
# PAYMENT_GATEWAY_KEY_SECRET=
# PAYMENT_GATEWAY_WEBHOOK_SECRET=
# CREDIT_BUREAU_API_KEY=
# CREDIT_BUREAU_BASE_URL=
# KYC_GATEWAY_API_KEY=
# KYC_GATEWAY_BASE_URL=
# SENDGRID_API_KEY=

