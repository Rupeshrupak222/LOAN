# =============================================================================
# ADYAPAN LOAN MANAGEMENT SYSTEM (LMS) - FRONTEND ENVIRONMENT CONFIGURATION
# =============================================================================
# All NEXT_PUBLIC_* variables are embedded in browser client bundles.
# NEVER include backend secrets, database passwords, or private API keys here.

# 1. API BACKEND URL
# In development: http://localhost:4000/api/v1
# In production (with reverse-proxy / same-domain): /api/v1
# In production (dedicated API domain): https://api.adyapan.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# 2. OPTIONAL PUBLIC SUPABASE CLIENT KEYS (if using Supabase Auth in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key

